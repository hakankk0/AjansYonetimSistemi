<Window x:Class="AjansYonetim.Pencereler.AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:donusturuculer="clr-namespace:AjansYonetim.Donusturuculer"
        xmlns:kontroller="clr-namespace:AjansYonetim.Pencereler.KullaniciKontrolleri"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Hakan - Ajans Yönetim Sistemi"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ArkaPlanFirca}">

    <Window.Resources>
        <donusturuculer:TeslimTarihiRenkDonusturucu x:Key="TeslimRenkDonusturucu"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sol Menü -->
            <ColumnDefinition Width="230"/>
            <!-- Ana İçerik -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SOL MENÜ PANELİ ═══════════════ -->
        <Border Grid.Column="0" CornerRadius="0,18,18,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#12122A" Offset="0"/>
                    <GradientStop Color="#16162A" Offset="0.5"/>
                    <GradientStop Color="#1A1A32" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo / Başlık -->
                <Border Grid.Row="0" Margin="0,0,0,0" Padding="20,24,20,20">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="/logo/logo1.png" Width="36" Height="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="txtSidebarAjansAdi" Text="Ajans Yönetim" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource MetinFirca}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ajans Yönetim Sistemi" FontSize="11"
                                   Foreground="#64748B" HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ayırıcı Çizgi (gradient) -->
                <Border Grid.Row="1" Height="1" Margin="24,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#3F3F5F" Offset="0.3"/>
                            <GradientStop Color="#3F3F5F" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Menü Butonları -->
                <StackPanel Grid.Row="2" Margin="14,16,14,0">
                    <TextBlock Text="ANA MENÜ" FontSize="10" FontWeight="Bold" Foreground="#4A4A6A"
                               Margin="6,0,0,8"/>
                    <Button x:Name="btnDashboard" Click="DashboardTiklandi"
                            Style="{StaticResource AktifMenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnMusteriler" Click="MusterilerTiklandi"
                            Style="{StaticResource MenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Müşteriler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCalisanlar" Click="CalisanlarTiklandi"
                            Style="{StaticResource MenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Çalışanlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnProjeler" Click="ProjelerTiklandi"
                            Style="{StaticResource MenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Projeler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ARAÇLAR" FontSize="10" FontWeight="Bold" Foreground="#4A4A6A"
                               Margin="6,16,0,8"/>
                    <Button x:Name="btnKanban" Click="KanbanTiklandi"
                            Style="{StaticResource MenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Kanban" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnHareketler" Click="HareketlerTiklandi"
                            Style="{StaticResource MenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Hareketler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Alt Bilgi -->
                <StackPanel Grid.Row="3" Margin="14,0,14,16">
                    <Border Height="1" Margin="10,0,10,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#3F3F5F" Offset="0.3"/>
                                <GradientStop Color="#3F3F5F" Offset="0.7"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Button x:Name="btnAyarlar" Click="AyarlarTiklandi"
                            Style="{StaticResource MenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCikisYap" Click="CikisYapTiklandi"
                            Style="{StaticResource MenuButonStil}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TehlikeFirca}"/>
                            <TextBlock Text="Çıkış Yap" VerticalAlignment="Center" Foreground="{StaticResource TehlikeFirca}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ ANA İÇERİK PANELİ ═══════════════ -->
        <Grid Grid.Column="1" Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <!-- Başlık ve Filtre/Arama Çubuğu -->
                <RowDefinition Height="Auto"/>
                <!-- Özet Kartları -->
                <RowDefinition Height="Auto"/>
                <!-- DataGrid / İçerik -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── Üst Çubuk: Başlık + Filtre + Arama ─── -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sayfa Başlığı -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtSayfaBasligi" Text="Dashboard" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource MetinFirca}"/>
                    <TextBlock x:Name="txtSayfaAltBaslik" Text="Aktif projelerinize genel bakış" FontSize="13"
                               Foreground="{StaticResource MetinSonikFirca}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Sağ Üst: Ek Kontroller ve Bildirimler -->
                <StackPanel x:Name="pnlSagUst" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Senkronizasyon Durumu -->
                    <Border Background="#1E1E30" CornerRadius="10" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtSenkronIkon" Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource MetinSonikFirca}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtSonSenkron" Text="Son Senkron: Yükleniyor..."
                                       Foreground="{StaticResource MetinSonikFirca}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Bildirim Zili -->
                    <Border CornerRadius="12" Width="40" Height="40">
                        <Button x:Name="btnBildirimler" Click="BildirimlerTiklandi"
                                Width="40" Height="40" Cursor="Hand" ToolTip="Bildirimler">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bgBorder" CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2A2A42" Offset="0"/>
                                                <GradientStop Color="#2A2A3E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bgBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#3A3A5E" Offset="0"/>
                                                        <GradientStop Color="#3A3A52" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                <Border x:Name="bdgBildirimSayisi" Background="{StaticResource TehlikeFirca}" CornerRadius="8" 
                                        Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Margin="0,-8,-12,0" Visibility="Collapsed">
                                    <TextBlock x:Name="txtBildirimSayisi" Text="0" FontSize="9" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </Border>
                    
                    <!-- Bildirim Pop-up menüsü -->
                    <Popup x:Name="popBildirimler" PlacementTarget="{Binding ElementName=btnBildirimler}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="8">
                        <Border Background="#1C1C30" BorderBrush="{StaticResource KenarlıkFirca}" BorderThickness="1" CornerRadius="12" Width="320" MaxHeight="420">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="18,14,18,10">
                                    <TextBlock Text="Bildirimler" Foreground="{StaticResource MetinFirca}" FontWeight="Bold" FontSize="15"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Tümünü Okundu Yap" Foreground="{StaticResource VurguAcikFirca}" Background="Transparent" BorderThickness="0" FontSize="11" Click="TumBildirimleriOkunduIsaretle" Cursor="Hand" Margin="0,0,10,0"/>
                                        <Button Content="Tümünü Sil" Foreground="{StaticResource TehlikeFirca}" Background="Transparent" BorderThickness="0" FontSize="11" Click="TumBildirimleriSilTiklandi" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#3F3F5F" Offset="0.3"/>
                                            <GradientStop Color="#3F3F5F" Offset="0.7"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                
                                <ListBox x:Name="lstBildirimler" Grid.Row="1" Background="Transparent" BorderThickness="0" MaxHeight="340" Margin="0,4,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                     <ListBox.ItemTemplate>
                                          <DataTemplate>
                                               <Border Background="{Binding ArkaPlan}" CornerRadius="8" Padding="12,8" Margin="8,2,8,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Mesaj}" Foreground="{Binding DurumRengi}" FontSize="12" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FormatliTarih}" Foreground="{StaticResource MetinSonikFirca}" FontSize="10" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" Padding="4"
                                                                Tag="{Binding BildirimID}" Click="BildirimSilTiklandi" ToolTip="Kaldır"/>
                                                    </Grid>
                                               </Border>
                                          </DataTemplate>
                                     </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <TextBlock x:Name="txtBildirimYok" Grid.Row="1" Text="Yeni bildiriminiz yok." Foreground="{StaticResource MetinSonikFirca}" FontSize="12" HorizontalAlignment="Center" Margin="0,30,0,40" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- ─── DASHBOARD KONTROL ─── -->
            <kontroller:DashboardKontrol x:Name="ctrlDashboard" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>

            <!-- ─── TÜM PROJELER KONTROL ─── -->
            <kontroller:ProjelerKontrol x:Name="ctrlProjeler" Grid.Row="2" Visibility="Collapsed"/>

            <!-- ─── MÜŞTERİLER KONTROL ─── -->
            <kontroller:MusterilerKontrol x:Name="ctrlMusteriler" Grid.Row="2" Visibility="Collapsed"/>

            <!-- ─── ÇALIŞANLAR KONTROL ─── -->
            <kontroller:CalisanlarKontrol x:Name="ctrlCalisanlar" Grid.Row="2" Visibility="Collapsed"/>

            <!-- ─── KANBAN KONTROL ─── -->
            <kontroller:KanbanKontrol x:Name="ctrlKanban" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>

            <!-- ─── HAREKETLER KONTROL ─── -->
            <kontroller:HareketlerKontrol x:Name="ctrlHareketler" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>

            <!-- ─── AYARLAR KONTROL ─── -->
            <kontroller:AyarlarKontrol x:Name="ctrlAyarlar" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>
        </Grid>

        <!-- ═══════════════ OTURUM KİLİDİ OVERLAY ═══════════════ -->
        <Border x:Name="pnlOturumKilidi" Visibility="Collapsed"
                Background="#F20D0D1A" Panel.ZIndex="110"
                Grid.ColumnSpan="2">
            <Border Background="#1C1C30" CornerRadius="20" Padding="48,40"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MinWidth="400" BorderBrush="#3F3F5F" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- İkon -->
                    <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#FBBF24" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Oturum Kilitlendi" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource MetinFirca}" TextAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Güvenliğiniz için oturumunuz kilitlendi. Lütfen parolanızı girin."
                               FontSize="13" Foreground="{StaticResource MetinSonikFirca}" TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Parola" Foreground="{StaticResource MetinFirca}" FontSize="13" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtKilitParola" Style="{StaticResource ModernPasswordBoxStil}"
                                 Width="300" Height="44" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="TxtKilitHata" Text="" Foreground="{StaticResource TehlikeFirca}" FontSize="13"
                               TextAlignment="Center" Visibility="Collapsed" Margin="0,0,0,10"/>

                    <Button x:Name="BtnKilitAc" Content="Kilidi Aç" Style="{StaticResource VurguButonStil}"
                            Width="300" Height="44" FontSize="14" FontWeight="Bold"
                            Click="BtnKilitAc_Click"/>
                    <Button Content="Çıkış Yap ve Başka Hesaba Geç" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource MetinSonikFirca}" Cursor="Hand" Margin="0,15,0,0"
                            Click="BtnKilitCikis_Click" FontSize="12"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ═══════════════ LOADING OVERLAY ═══════════════ -->
        <Border x:Name="pnlYukleniyor" Visibility="Collapsed"
                Background="#CC0D0D1A" Panel.ZIndex="100"
                Grid.ColumnSpan="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Dönen yükleniyor ikonu -->
                <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C3AED" Offset="0"/>
                            <GradientStop Color="#A78BFA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="txtYukleniyorMesaj" Text="Yükleniyor..."
                           Foreground="{StaticResource MetinFirca}" FontSize="15" FontWeight="SemiBold"
                           TextAlignment="Center"/>
                <TextBlock Text="Lütfen bekleyiniz..." Foreground="{StaticResource MetinSonikFirca}"
                           FontSize="12" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
