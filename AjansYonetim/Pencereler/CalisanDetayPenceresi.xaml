<Window x:Class="AjansYonetim.Pencereler.CalisanDetayPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çalışan Detay"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ArkaPlanFirca}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
        <StackPanel>
            <!-- Başlık -->
            <Border CornerRadius="14" Padding="24,18" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2A2A42" Offset="0"/>
                        <GradientStop Color="#2A2A3E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22C55E" Offset="0"/>
                                    <GradientStop Color="#4ADE80" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtBaslik" Text="Çalışan Detay" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource MetinFirca}"/>
                            <TextBlock x:Name="txtAltBaslik" Text="" FontSize="13"
                                       Foreground="{StaticResource MetinSonikFirca}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource VurguButonStil}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="DuzenleTiklandi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Çalışan Bilgileri -->
            <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="22,18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Telefon" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtTelefon" Foreground="{StaticResource MetinFirca}" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="E-posta" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtEposta" Foreground="{StaticResource MetinFirca}" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Departman" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtDepartman" Foreground="{StaticResource MetinFirca}" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="Pozisyon" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtPozisyon" Foreground="{StaticResource MetinFirca}" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Çalışan Türü" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtCalisanTuru" Foreground="{StaticResource VurguAcikFirca}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="Durum" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtDurum" Foreground="{StaticResource BasariFirca}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="İşe Başlama" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtIseBaslama" Foreground="{StaticResource MetinFirca}" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                        <TextBlock Text="Notlar" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                        <TextBlock x:Name="txtNotlar" Foreground="{StaticResource MetinFirca}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Performans Metrikleri -->
            <TextBlock FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource MetinFirca}" Margin="0,4,0,12"><Run Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Performans"/></TextBlock>

            <UniformGrid Columns="5" Margin="0,0,0,16">
                <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="14,12" Margin="0,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Toplam" Foreground="{StaticResource MetinSonikFirca}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtToplamProje" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource MetinFirca}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="14,12" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Tamamlanan" Foreground="{StaticResource MetinSonikFirca}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTamamlanan" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource BasariFirca}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="14,12" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Aktif" Foreground="{StaticResource MetinSonikFirca}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtAktif" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource VurguAcikFirca}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="14,12" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Geciken" Foreground="{StaticResource MetinSonikFirca}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtGeciken" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TehlikeFirca}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="14,12" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Başarı %" Foreground="{StaticResource MetinSonikFirca}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtBasariOrani" Text="%0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource BasariFirca}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Atanan Projeler -->
            <TextBlock FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource MetinFirca}" Margin="0,4,0,12"><Run Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Atanan Projeler"/></TextBlock>

            <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="4" MinHeight="150">
                <DataGrid x:Name="dgProjeler"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          Background="Transparent" Foreground="{StaticResource MetinFirca}"
                          BorderThickness="0" RowHeaderWidth="0" Margin="8,0,8,8" FontSize="13"
                          RowStyle="{StaticResource DataGridSatirStil}"
                          CellStyle="{StaticResource DataGridHucreStil}"
                          ColumnHeaderStyle="{StaticResource DataGridSutunBaslikStil}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proje Adı" Binding="{Binding ProjeAdi}" Width="*"/>
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding MusteriAdSoyad}" Width="130"/>
                        <DataGridTextColumn Header="Teslim" Binding="{Binding TeslimTarihi, StringFormat=dd.MM.yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="110"/>
                        <DataGridTextColumn Header="" Binding="{Binding GecikmeEtiketi}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel x:Name="pnlProjeBos" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Center">
                <TextBlock Text="Bu çalışana henüz proje atanmamış." FontSize="13"
                           Foreground="{StaticResource MetinSonikFirca}" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
