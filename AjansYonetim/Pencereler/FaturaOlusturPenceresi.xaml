<Window x:Class="AjansYonetim.Pencereler.FaturaOlusturPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fatura / Teklif Oluştur"
        Width="570" Height="640"
        MinWidth="450" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" ClipToBounds="True" BorderBrush="#3F3F5F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid Background="{StaticResource ArkaPlanFirca}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Çubuğu -->
            <Border Grid.Row="0" Padding="24,16" MouseLeftButtonDown="Pencere_Surukle">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#14142A" Offset="0"/>
                        <GradientStop Color="#1A1A32" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#FBBF24" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fatura / Teklif Oluştur" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource MetinFirca}"/>
                            <TextBlock Text="PDF fatura veya fiyat teklifi oluşturun" FontSize="11"
                                       Foreground="{StaticResource MetinSonikFirca}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="IptalTiklandi">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="32" Height="32" CornerRadius="8" Background="Transparent">
                                    <TextBlock Text="✕" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2A2A42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form İçeriği -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,10,20,0">
                <StackPanel>
                    <TextBlock Text="Belge Türü" Style="{StaticResource FormEtiketStil}"/>
                    <ComboBox x:Name="cmbBelgeTuru" Style="{StaticResource ModernComboBoxStil}"
                              Height="40" Margin="0,0,0,14" SelectionChanged="BelgeTuruDegisti"/>

                    <TextBlock Text="Müşteri *" Style="{StaticResource FormEtiketStil}"/>
                    <ComboBox x:Name="cmbMusteri" Style="{StaticResource ModernComboBoxStil}"
                              Height="40" Margin="0,0,0,14" SelectionChanged="MusteriDegisti"/>

                    <TextBlock Text="Proje (opsiyonel)" Style="{StaticResource FormEtiketStil}"/>
                    <ComboBox x:Name="cmbProje" Style="{StaticResource ModernComboBoxStil}"
                              Height="40" Margin="0,0,0,14" SelectionChanged="ProjeDegisti"/>

                    <TextBlock Text="Tarih *" Style="{StaticResource FormEtiketStil}"/>
                    <DatePicker x:Name="dpTarih" Height="40" Margin="0,0,0,14"/>

                    <!-- Tutar, Para Birimi ve KDV -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tutar *" Style="{StaticResource FormEtiketStil}"/>
                            <TextBox x:Name="txtTutar" Style="{StaticResource ModernTextBoxStil}"
                                     Height="40" PreviewTextInput="FiyatSadeceRakam"
                                     TextChanged="TutarDegisti"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kuru *" Style="{StaticResource FormEtiketStil}"/>
                            <ComboBox x:Name="cmbParaBirimi" Style="{StaticResource ModernComboBoxStil}"
                                      Height="40" SelectionChanged="ParaBirimiDegisti"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="KDV (%)" Style="{StaticResource FormEtiketStil}"/>
                            <ComboBox x:Name="cmbKDV" Style="{StaticResource ModernComboBoxStil}"
                                      Height="40" SelectionChanged="KDVDegisti"/>
                        </StackPanel>
                    </Grid>

                    <!-- Toplam -->
                    <Border CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1A1A30" Offset="0"/>
                                <GradientStop Color="#1E1E34" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GENEL TOPLAM" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource MetinSonikFirca}"/>
                                <TextBlock x:Name="txtKDVDetay" Text="KDV: ₺0,00" FontSize="10"
                                           Foreground="{StaticResource MetinSonikFirca}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="txtToplamTutar" Grid.Column="1" Text="₺0,00"
                                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#A78BFA" Offset="0"/>
                                        <GradientStop Color="#C4B5FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="Açıklama / Not" Style="{StaticResource FormEtiketStil}"/>
                    <TextBox x:Name="txtAciklama" Style="{StaticResource ModernTextBoxStil}"
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Butonlar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,20">
                <Button Content="İptal" Style="{StaticResource IkincilButonStil}"
                        Click="IptalTiklandi" Margin="0,0,10,0" Padding="24,12"/>
                <Button Style="{StaticResource VurguButonStil}" Click="PdfOlusturTiklandi" Padding="24,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="PDF Oluştur &amp; Kaydet" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
