<Window x:Class="AjansYonetim.Pencereler.GirisPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajans Yönetim - Giriş" Height="580" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Pencere_Surukle"
        Icon="/logo/logo1.png">
    
    <Border CornerRadius="18" ClipToBounds="True"
            BorderBrush="#3F3F5F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Border.Background>
            <SolidColorBrush Color="{StaticResource ArkaPlanRenk}"/>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Sağ Üst Kapatma Butonu -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Grid.ColumnSpan="2" Panel.ZIndex="10"
                    Margin="15" Width="34" Height="34" Cursor="Hand" Click="KapatButon_Click"
                    ToolTip="Kapat">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="kapatBd" Background="Transparent" CornerRadius="10"
                                Width="34" Height="34">
                            <TextBlock Text="✕" FontSize="14" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="kapatBd" Property="Background" Value="#352535"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="kapatBd" Property="Background" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ═══ SOL / GÖRSEL ALANI ═══ -->
            <Border Grid.Column="0" CornerRadius="17,0,0,17">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1040" Offset="0"/>
                        <GradientStop Color="#2A2A3E" Offset="0.5"/>
                        <GradientStop Color="#16162A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Dekoratif gradient daireler -->
                    <Ellipse Width="200" Height="200" Opacity="0.08"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-60,-40,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="160" Height="160" Opacity="0.06"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-30,-30">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center" Margin="44">
                        <!-- Logo -->
                        <Image Source="/logo/logo1.png" Width="56" Height="56"
                               HorizontalAlignment="Left" Margin="0,0,0,16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Başlık -->
                        <TextBlock FontSize="32" FontWeight="Black" Margin="0,0,0,2">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#A78BFA" Offset="0"/>
                                    <GradientStop Color="#C4B5FD" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            AJANS YÖNETİM
                        </TextBlock>
                        <TextBlock Text="SİSTEMİ" FontSize="18" FontWeight="Bold"
                                   Foreground="#64748B" Margin="0,0,0,28"/>

                        <!-- Alt açıklama -->
                        <TextBlock Text="Hoş Geldiniz!" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource MetinFirca}" Margin="0,0,0,10"/>
                        <TextBlock Text="Ajans verilerinizi güvenle yönetin, muhasebe ve projelerinizi tek bir noktadan takip edin." 
                                   TextWrapping="Wrap" FontSize="14" Foreground="#94A3B8" LineHeight="22"
                                   MaxWidth="340" HorizontalAlignment="Left"/>

                        <!-- Alt dekoratif çizgi -->
                        <Border Margin="0,28,0,0" Height="3" Width="60" HorizontalAlignment="Left"
                                CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ SAĞ / FORM ALANI ═══ -->
            <Grid Grid.Column="1" Margin="40,24">
                <!-- PANEL: GİRİŞ YAP -->
                <StackPanel x:Name="PnlGirisYap" VerticalAlignment="Center" Visibility="Visible">
                    <!-- Hata / Bilgi Mesajı -->
                    <Border Margin="0,0,0,12" Visibility="{Binding Visibility, ElementName=TxtGirisMesaj}">
                        <TextBlock x:Name="TxtGirisMesaj" Foreground="{StaticResource TehlikeFirca}" FontSize="13"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </Border>

                    <TextBlock Text="E-Posta Adresi" Style="{StaticResource FormEtiketStil}"/>
                    <TextBox x:Name="TxtGirisEmail" Style="{StaticResource ModernTextBoxStil}" Height="42" Margin="0,0,0,15" Padding="12,0"/>

                    <TextBlock Text="Parola" Style="{StaticResource FormEtiketStil}"/>
                    <PasswordBox x:Name="TxtGirisParola" Style="{StaticResource ModernPasswordBoxStil}" Height="42" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkBeniHatirla" Content="Beni Hatırla (Bu cihazı güvene al)" IsChecked="True"
                                  Foreground="{StaticResource MetinSonikFirca}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Şifremi Unuttum?" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource VurguAcikFirca}" Cursor="Hand" Click="LnkSifremiUnuttum_Click" FontSize="12"/>
                    </Grid>

                    <!-- Kod Doğrulama Alanı (Başlangıçta Gizli) -->
                    <StackPanel x:Name="PnlGirisKod" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Yeni Cihaz - E-Postanızdaki 6 Haneli Şifre" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="TxtGirisKod" Style="{StaticResource ModernTextBoxStil}" Height="46" Margin="0,0,0,15" Padding="12,0" MaxLength="6" TextAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        <Button Content="Doğrula ve Cihazı Kaydet" Style="{StaticResource VurguButonStil}" Height="44" Click="BtnGirisAdim2_Click"/>
                    </StackPanel>

                    <!-- Giriş Adım 1 Butonu -->
                    <Button x:Name="BtnGirisAdim1" Content="Giriş Yap" Style="{StaticResource VurguButonStil}" Height="44" FontSize="14" FontWeight="Bold" Click="BtnGirisAdim1_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <TextBlock Text="Hesabınız yok mu? " Foreground="{StaticResource MetinSonikFirca}" VerticalAlignment="Center"/>
                        <Button Content="Kayıt Ol" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource VurguAcikFirca}" FontWeight="Bold" Cursor="Hand"
                                Click="LnkKayitGecis_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- PANEL: KAYIT OL -->
                <StackPanel x:Name="PnlKayitOl" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Yeni Ajans Kaydı" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MetinFirca}" Margin="0,0,0,4"/>
                    <Border Height="3" Width="50" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    
                    <!-- Hata / Bilgi Mesajı -->
                    <TextBlock x:Name="TxtKayitMesaj" Foreground="{StaticResource TehlikeFirca}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <TextBlock Text="Ajans Adı *" Style="{StaticResource FormEtiketStil}"/>
                    <TextBox x:Name="TxtKayitAd" Style="{StaticResource ModernTextBoxStil}" Height="40" Padding="12,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Telefon Numarası" Style="{StaticResource FormEtiketStil}"/>
                    <TextBox x:Name="TxtKayitTel" Style="{StaticResource ModernTextBoxStil}" Height="40" Padding="12,0" Margin="0,0,0,10"/>

                    <TextBlock Text="E-Posta Adresi (Giriş İçin) *" Style="{StaticResource FormEtiketStil}"/>
                    <TextBox x:Name="TxtKayitEmail" Style="{StaticResource ModernTextBoxStil}" Height="40" Padding="12,0" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Parola *" Style="{StaticResource FormEtiketStil}"/>
                            <PasswordBox x:Name="TxtKayitParola" Style="{StaticResource ModernPasswordBoxStil}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Parola Tekrar *" Style="{StaticResource FormEtiketStil}"/>
                            <PasswordBox x:Name="TxtKayitParolaTekrar" Style="{StaticResource ModernPasswordBoxStil}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Kod Doğrulama Alanı (Kayıt İçin, Başlangıçta Gizli) -->
                    <StackPanel x:Name="PnlKayitKod" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="E-Postanıza Gönderilen 6 Haneli Şifre" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="TxtKayitKod" Style="{StaticResource ModernTextBoxStil}" Height="46" Margin="0,0,0,15" Padding="12,0" MaxLength="6" TextAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        <Button x:Name="BtnKayitAdim2" Content="Doğrula ve Kaydı Tamamla" Style="{StaticResource VurguButonStil}" Height="44" Click="BtnKayitAdim2_Click"/>
                    </StackPanel>

                    <!-- Kayıt Adım 1 Butonu -->
                    <Button x:Name="BtnKayitAdim1" Content="Doğrulama Kodu Gönder" Style="{StaticResource VurguButonStil}" Height="44" Click="BtnKayitAdim1_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="Zaten hesabınız var mı? " Foreground="{StaticResource MetinSonikFirca}" VerticalAlignment="Center"/>
                        <Button Content="Giriş Yap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource VurguAcikFirca}" FontWeight="Bold" Cursor="Hand" Click="LnkGirisGecis_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- PANEL: ŞİFRE SIFIRLAMA -->
                <StackPanel x:Name="PnlSifreSifirlama" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Şifre Yenileme" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MetinFirca}" Margin="0,0,0,4"/>
                    <Border Height="3" Width="50" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#FBBF24" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Kayıtlı e-posta adresinize 6 haneli doğrulama kodu göndereceğiz." FontSize="13" Foreground="{StaticResource MetinSonikFirca}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    
                    <!-- Hata / Bilgi Mesajı -->
                    <TextBlock x:Name="TxtSifirlamaMesaj" Foreground="{StaticResource TehlikeFirca}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <TextBlock Text="E-Posta Adresi" Style="{StaticResource FormEtiketStil}"/>
                    <TextBox x:Name="TxtSifirlamaEmail" Style="{StaticResource ModernTextBoxStil}" Height="42" Padding="12,0" Margin="0,0,0,15"/>

                    <StackPanel x:Name="PnlSifirlamaKod" Visibility="Collapsed" Margin="0,0,0,15">
                        <TextBlock Text="E-Postanıza Gelen 6 Haneli Şifre" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="TxtSifirlamaKod" Style="{StaticResource ModernTextBoxStil}" Height="46" Margin="0,0,0,15" Padding="12,0" MaxLength="6" TextAlignment="Center" FontSize="18" FontWeight="Bold"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Yeni Parola *" Style="{StaticResource FormEtiketStil}"/>
                                <PasswordBox x:Name="TxtSifirlamaParola" Style="{StaticResource ModernPasswordBoxStil}" Height="42"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Parola Tekrar *" Style="{StaticResource FormEtiketStil}"/>
                                <PasswordBox x:Name="TxtSifirlamaParolaTekrar" Style="{StaticResource ModernPasswordBoxStil}" Height="42"/>
                            </StackPanel>
                        </Grid>
                        
                        <Button x:Name="BtnSifirlamaAdim2" Content="Şifreyi Yenile" Style="{StaticResource VurguButonStil}" Height="44" Click="BtnSifirlamaAdim2_Click"/>
                    </StackPanel>

                    <Button x:Name="BtnSifirlamaAdim1" Content="Doğrulama Kodu Gönder" Style="{StaticResource VurguButonStil}" Height="44" Click="BtnSifirlamaAdim1_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="Giriş Ekranına Dön" Background="Transparent" BorderThickness="0" Foreground="{StaticResource VurguAcikFirca}" FontWeight="Bold" Cursor="Hand" Click="LnkGirisGecis_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
