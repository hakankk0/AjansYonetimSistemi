<UserControl x:Class="AjansYonetim.Pencereler.KullaniciKontrolleri.AyarlarKontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,20">

                <!-- Ajans Bilgileri -->
                <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Ajans Bilgileri" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Ajans Adı" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="txtAjansAdi" Style="{StaticResource ModernTextBoxStil}" Margin="0,0,0,4"
                                 IsReadOnly="True" Background="#16162A" Opacity="0.8"/>
                        <TextBlock x:Name="txtLisansDurumu" FontSize="11" Margin="0,0,0,14"
                                   Foreground="{StaticResource BasariFirca}" TextWrapping="Wrap"/>

                        <TextBlock Text="Telefon" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="txtAjansTelefon" Style="{StaticResource ModernTextBoxStil}" Margin="0,0,0,14"
                                 PreviewTextInput="TelefonSadeceRakam"/>

                        <TextBlock Text="E-posta" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="txtAjansEposta" Style="{StaticResource ModernTextBoxStil}" Margin="0,0,0,14"/>

                        <TextBlock Text="Adres" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="txtAjansAdres" Style="{StaticResource ModernTextBoxStil}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="80"
                                 VerticalContentAlignment="Top" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource VurguButonStil}"
                                    Click="AjansBilgileriKaydetTiklandi" Padding="24,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Bilgileri Kaydet" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IkincilButonStil}"
                                    Margin="12,0,0,0" Click="LisansDegistirTiklandi" Padding="24,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Lisansı Değiştir" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Uygulama Ayarları -->
                <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#60A5FA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Uygulama Ayarları" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Acil Proje Uyarı Eşiği (gün)" Style="{StaticResource FormEtiketStil}"/>
                        <TextBlock Text="Teslim tarihine bu kadar gün veya daha az kalmış projeler kırmızı ile işaretlenir."
                                   Foreground="{StaticResource MetinSonikFirca}" FontSize="11" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtAcilGunEsigi" Style="{StaticResource ModernTextBoxStil}"
                                 Text="2" Width="100" HorizontalAlignment="Left" Margin="0,0,0,16"
                                 PreviewTextInput="AcilEsikSadeceRakam"/>

                        <TextBlock Text="Otomatik Yedekleme Aralığı" Style="{StaticResource FormEtiketStil}"/>
                        <TextBlock Text="Uygulama açılışında veritabanı yedeği otomatik alınır."
                                   Foreground="{StaticResource MetinSonikFirca}" FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbYedeklemeAraligi" Style="{StaticResource ModernComboBoxStil}"
                                  Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <Button Style="{StaticResource VurguButonStil}"
                                HorizontalAlignment="Left" Click="UygulamaAyarlariKaydetTiklandi" Padding="24,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ayarları Kaydet" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Veritabanı Yönetimi -->
                <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#4ADE80" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE7F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Veritabanı Yönetimi" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Veritabanı dosyasının yedeğini alabilir veya konumunu görüntüleyebilirsiniz."
                                   Foreground="{StaticResource MetinSonikFirca}" FontSize="12" Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource VurguButonStil}"
                                    Click="VeritabaniKonumuTiklandi" Margin="0,0,12,0" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Veritabanı Konumunu Aç" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource VurguButonStil}"
                                    Click="YedekAlTiklandi" Margin="0,0,12,0" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Yedek Al" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IkincilButonStil}"
                                    Click="YedekGeriYukleTiklandi" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Yedekten Geri Yükle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bulut Yedekleme -->
                <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#818CF8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Bulut Yedekleme (Firebase)" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock x:Name="txtBulutYedekDurumu" Text="Bulut durumu kontrol ediliyor..."
                                   Foreground="{StaticResource BilgiFirca}" FontSize="12" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource VurguButonStil}"
                                    Click="BulutaYedekleTiklandi" Margin="0,0,12,0" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tüm Veriyi Buluta Yedekle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IkincilButonStil}"
                                    Click="BuluttanKurtarTiklandi" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Buluttan Kurtar / Eşitle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CSV İşlemleri -->
                <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#FBBF24" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Veri Aktarma (CSV)" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Müşteri ve proje verilerinizi CSV formatında dışa aktarabilir veya CSV'den içe aktarabilirsiniz."
                                   Foreground="{StaticResource MetinSonikFirca}" FontSize="12" Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource VurguButonStil}"
                                    Click="MusteriDisaAktarTiklandi" Margin="0,0,12,0" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Müşteri Dışa Aktar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource VurguButonStil}"
                                    Click="ProjeDisaAktarTiklandi" Margin="0,0,12,0" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Proje Dışa Aktar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IkincilButonStil}"
                                    Click="MusteriIceAktarTiklandi" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Müşteri İçe Aktar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hakkında -->
                <Border CornerRadius="14" Padding="24,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2A2A42" Offset="0"/>
                            <GradientStop Color="#2A2A3E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Hakkında" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource MetinSonikFirca}" FontSize="13" TextWrapping="Wrap">
                            <Run Text="Ajans Yönetim Sistemi" FontWeight="SemiBold" Foreground="{StaticResource VurguAcikFirca}"/>
                            <LineBreak/>
                            <Run Text="Sürüm: 2.0.0"/>
                            <LineBreak/>
                            <Run Text="Platform: C# WPF + SQLite"/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Tasarım ajansları ve freelance çalışanlar için müşteri ve proje yönetim sistemi."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
