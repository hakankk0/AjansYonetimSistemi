<UserControl x:Class="AjansYonetim.Pencereler.KullaniciKontrolleri.DashboardKontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Filtreleme Alanı (Eskiden AnaPencere Top Bar'daydı) -->
            <RowDefinition Height="Auto"/>
            <!-- Özet Kartları -->
            <RowDefinition Height="Auto"/>
            <!-- İçerik -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── Filtre + Arama Alanı ─── -->
        <StackPanel x:Name="pnlFiltre" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="txtArama" Style="{StaticResource ModernTextBoxStil}"
                     Width="180" Height="40" FontSize="13" Margin="0,0,10,0" TextChanged="AramaDegisti"/>
            <TextBlock Text="Durum:" Foreground="{StaticResource MetinSonikFirca}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltre" Width="140" Height="36" FontSize="12"
                      Style="{StaticResource ModernComboBoxStil}" SelectionChanged="FiltreDegisti"/>
            <TextBlock Text="Kategori:" Foreground="{StaticResource MetinSonikFirca}"
                       FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <ComboBox x:Name="cmbKategoriFiltre" Width="140" Height="36" FontSize="12"
                      Style="{StaticResource ModernComboBoxStil}" SelectionChanged="KategoriFiltreDegisti"/>
        </StackPanel>

        <!-- ─── Özet Kartları (6 kart) ─── -->
        <Grid x:Name="gridOzetKartlari" Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toplam Proje -->
            <Border Grid.Column="0" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,14" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Toplam Proje" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtToplamProje" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource MetinFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Aktif Proje -->
            <Border Grid.Column="1" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,14" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Aktif Proje" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtAktifProje" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource VurguAcikFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Acil Proje -->
            <Border Grid.Column="2" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,14" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock x:Name="txtAcilBaslik" Text="Acil (≤2 Gün)" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtAcilProje" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TehlikeFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Toplam Müşteri -->
            <Border Grid.Column="3" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,14" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Toplam Müşteri" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtToplamMusteri" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BasariFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Toplam Gelir -->
            <Border Grid.Column="4" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,14" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Toplam Gelir" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtToplamGelir" Text="₺0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BasariFirca}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtBuAyTrend" Text="" FontSize="10" Foreground="{StaticResource MetinSonikFirca}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="txtKurBilgisiDashboard" Text="" FontSize="9" Foreground="{StaticResource VurguAcikFirca}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Bekleyen Ödeme -->
            <Border Grid.Column="5" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,14" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Bekleyen Ödeme" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtBekleyenOdeme" Text="₺0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource UyariFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════ DASHBOARD GÖRÜNÜMÜ ═══════════════ -->
        <Grid x:Name="gridDashboard" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,12,16,8">
                        <TextBlock Text="Aktif Projeler" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MetinFirca}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource VurguButonStil}" Click="RaporTiklandi" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Rapor" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="＋ Yeni Proje" Style="{StaticResource VurguButonStil}" Click="YeniProjeTiklandi" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource VurguButonStil}" Click="ProjeDuzenleTiklandi" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TehlikeButonStil}" Click="ProjeSilTiklandi">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Sil" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="dgProjeler" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" Foreground="{StaticResource MetinFirca}"
                              BorderThickness="0" RowHeaderWidth="0" Margin="8,0,8,8" FontSize="13"
                              RowStyle="{StaticResource DataGridSatirStil}" CellStyle="{StaticResource DataGridHucreStil}"
                              ColumnHeaderStyle="{StaticResource DataGridSutunBaslikStil}" MouseDoubleClick="ProjeDetayCiftTiklama">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proje Adı" Binding="{Binding ProjeAdi}" Width="*"/>
                            <DataGridTextColumn Header="Müşteri" Binding="{Binding MusteriAdSoyad}" Width="130"/>
                            <DataGridTextColumn Header="Teslim" Binding="{Binding TeslimTarihi, StringFormat=dd.MM.yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Fiyat" Binding="{Binding FiyatGosterim}" Width="100"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="120"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="100"/>
                            <DataGridTextColumn Header="Ekip" Binding="{Binding EkipMetni}" Width="150"/>
                            <DataGridTextColumn Header="" Binding="{Binding GecikmeEtiketi}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="pnlDashboardBos" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Henüz aktif proje bulunmuyor" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MetinSonikFirca}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Yeni proje eklemek için '＋ Yeni Proje' butonunu kullanın" FontSize="13" Foreground="{StaticResource MetinSonikFirca}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0" x:Name="gridGrafikler">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,12" Margin="0,0,6,0" Height="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MetinFirca}" Margin="0,0,0,8"><Run Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Aylık Gelir"/></TextBlock>
                        <lvc:CartesianChart x:Name="chartAylikGelir" Grid.Row="1"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="16,12" Margin="6,0,0,0" Height="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MetinFirca}" Margin="0,0,0,8"><Run Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Durum Dağılımı"/></TextBlock>
                        <lvc:PieChart x:Name="chartDurumDagilimi" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
