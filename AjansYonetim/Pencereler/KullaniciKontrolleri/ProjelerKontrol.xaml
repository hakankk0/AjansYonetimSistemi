<UserControl x:Class="AjansYonetim.Pencereler.KullaniciKontrolleri.ProjelerKontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <Border Background="{StaticResource KartFirca}" CornerRadius="14" Padding="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,14,18,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tüm Projeler" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="cmbTopluDurum" Style="{StaticResource ModernComboBoxStil}"
                              Width="150" Height="32" FontSize="12" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource VurguButonStil}"
                            Click="TopluDurumGuncelleTiklandi" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Toplu Güncelle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IkincilButonStil}"
                            Click="RaporTiklandi" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Rapor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="＋ Yeni Proje" Style="{StaticResource VurguButonStil}"
                            Click="YeniProjeTiklandi" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource IkincilButonStil}"
                            Click="TumProjelerDuzenleTiklandi" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TehlikeButonStil}"
                            Click="TumProjelerSilTiklandi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Sil" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgTumProjeler" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="Transparent" Foreground="{StaticResource MetinFirca}"
                      BorderThickness="0" RowHeaderWidth="0" Margin="8,0,8,8" FontSize="13"
                      RowStyle="{StaticResource DataGridSatirStil}"
                      CellStyle="{StaticResource DataGridHucreStil}"
                      ColumnHeaderStyle="{StaticResource DataGridSutunBaslikStil}"
                      MouseDoubleClick="ProjeDetayCiftTiklama">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Proje Adı" Binding="{Binding ProjeAdi}" Width="*"/>
                    <DataGridTextColumn Header="Müşteri" Binding="{Binding MusteriAdSoyad}" Width="150"/>
                    <DataGridTextColumn Header="Başlangıç" Binding="{Binding BaslangicTarihi, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Teslim" Binding="{Binding TeslimTarihi, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Fiyat" Binding="{Binding FiyatGosterim}" Width="100"/>
                    <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="150"/>
                    <DataGridTextColumn Header="Ekip" Binding="{Binding EkipMetni}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
