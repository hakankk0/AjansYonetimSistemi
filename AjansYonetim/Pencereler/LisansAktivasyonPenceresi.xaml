<Window x:Class="AjansYonetim.Pencereler.LisansAktivasyonPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lisans Aktivasyonu"
        Width="540" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="18" ClipToBounds="True" BorderBrush="#3F3F5F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E1E2E" Offset="0"/>
                    <GradientStop Color="#16162A" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Dekoratif daireler -->
            <Ellipse Width="200" Height="200" Opacity="0.06"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-60,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo ve Başlık -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ajans Yönetim Sistemi" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource MetinFirca}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Lisans Aktivasyonu" FontSize="12"
                               Foreground="{StaticResource MetinSonikFirca}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Açıklama -->
                <TextBlock Grid.Row="1" Text="Uygulamayı kullanmak için geçerli bir lisans anahtarı giriniz."
                           Foreground="{StaticResource MetinSonikFirca}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"/>

                <!-- Lisans Anahtarı Girişi -->
                <TextBlock Grid.Row="2" Text="Lisans Anahtarı" Style="{StaticResource FormEtiketStil}"/>
                <TextBox Grid.Row="3" x:Name="txtLisansAnahtari"
                         Style="{StaticResource ModernTextBoxStil}"
                         FontFamily="Consolas" TextWrapping="Wrap"
                         AcceptsReturn="False" Height="60"
                         VerticalContentAlignment="Top" Margin="0,0,0,8"/>

                <!-- Hata Mesajı -->
                <TextBlock Grid.Row="4" x:Name="txtHataMesaji"
                           Foreground="{StaticResource TehlikeFirca}" FontSize="12"
                           Visibility="Collapsed" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>

                <!-- Butonlar -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Çıkış" Style="{StaticResource IkincilButonStil}"
                            Padding="24,12" Click="CikisTiklandi" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource VurguButonStil}" Padding="24,12"
                            Click="EtkinlestirTiklandi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Etkinleştir" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
