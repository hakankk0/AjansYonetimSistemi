<Window x:Class="AjansYonetim.Pencereler.MusteriDetayPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri Detayı"
        Width="980" Height="720"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ArkaPlanFirca}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Müşteri Başlık Kartı -->
        <Border Grid.Row="0" CornerRadius="14" Padding="24,18" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2A2A42" Offset="0"/>
                    <GradientStop Color="#2A2A3E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Margin="0,0,16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtMusteriAdi" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource MetinFirca}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="txtSirketBilgisi" Foreground="{StaticResource MetinSonikFirca}" FontSize="13"
                                   Margin="0,0,20,0"/>
                        <TextBlock x:Name="txtIletisim" Foreground="{StaticResource MetinSonikFirca}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource VurguButonStil}"
                        Click="FaturaOlusturTiklandi" Padding="16,10" FontSize="13" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Fatura / Teklif Oluştur" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Özet Kartları -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="16,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Toplam Proje" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtToplamProje" Foreground="{StaticResource BilgiFirca}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Aktif Proje" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtAktifProje" Foreground="{StaticResource VurguAcikFirca}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Toplam Fiyat" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtToplamFiyat" Foreground="{StaticResource MetinFirca}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Toplam Ödenen" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtToplamOdenen" Foreground="{StaticResource BasariFirca}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource KartFirca}" CornerRadius="10" Padding="16,12" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Kalan Borç" Foreground="{StaticResource MetinSonikFirca}" FontSize="11"/>
                    <TextBlock x:Name="txtKalanBorc" Foreground="{StaticResource UyariFirca}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Alt İçerik -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Proje Listesi -->
            <Border Grid.Column="0" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MetinFirca}" Margin="0,0,0,12">
                        <Run Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Müşterinin Projeleri"/>
                    </TextBlock>
                    <DataGrid x:Name="dgMusteriProjeleri" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" Foreground="{StaticResource MetinFirca}"
                              BorderThickness="0" RowHeaderWidth="0" FontSize="13"
                              RowStyle="{StaticResource DataGridSatirStil}"
                              CellStyle="{StaticResource DataGridHucreStil}"
                              ColumnHeaderStyle="{StaticResource DataGridSutunBaslikStil}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proje Adı" Binding="{Binding ProjeAdi}" Width="*"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="120"/>
                            <DataGridTextColumn Header="Fiyat" Binding="{Binding FiyatGosterim}" Width="90"/>
                            <DataGridTextColumn Header="Teslim" Binding="{Binding TeslimTarihi, StringFormat=dd.MM.yyyy}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- İletişim Geçmişi -->
            <Border Grid.Column="2" Background="{StaticResource KartFirca}" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MetinFirca}" Margin="0,0,0,12">
                        <Run Text="&#xE70B;" FontFamily="Segoe MDL2 Assets"/><Run Text=" İletişim Geçmişi"/>
                    </TextBlock>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <ComboBox x:Name="cmbIletisimTuru" Style="{StaticResource ModernComboBoxStil}"
                                  Height="32" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtYeniIletisimNotu" Style="{StaticResource ModernTextBoxStil}"
                                 Height="60" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                        <Button Content="+ Not Ekle" Style="{StaticResource VurguButonStil}"
                                Height="34" FontSize="13" FontWeight="Bold"
                                Foreground="White" Click="IletisimNotuEkleTiklandi"/>
                    </StackPanel>

                    <ListBox x:Name="lstIletisimNotlari" Grid.Row="2"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A2E" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding IletisimTuru}" Foreground="{StaticResource VurguAcikFirca}"
                                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding OlusturmaTarihi, StringFormat=dd.MM.yyyy HH:mm}"
                                                       Foreground="{StaticResource MetinSonikFirca}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Grid.Row="0" Grid.Column="1" Content="✕" Tag="{Binding NotID}"
                                                Style="{StaticResource TehlikeButonStil}"
                                                Width="22" Height="22" FontSize="10" Padding="0"
                                                Click="IletisimNotuSilTiklandi"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NotMetni}"
                                                   Foreground="{StaticResource MetinFirca}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
