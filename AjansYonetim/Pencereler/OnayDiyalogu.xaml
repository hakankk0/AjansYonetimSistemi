<Window x:Class="AjansYonetim.Pencereler.OnayDiyalogu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bildirim"
        Width="460" Height="Auto" SizeToContent="Height"
        MinWidth="360" MaxWidth="560"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Loaded="Pencere_Yuklendi">

    <Window.Resources>
        <!-- ═══════════════ ANİMASYONLAR ═══════════════ -->

        <!-- Pencere açılış animasyonu -->
        <Storyboard x:Key="AcilisAnimasyonu">
            <!-- Fade In -->
            <DoubleAnimation
                Storyboard.TargetName="AnaKart"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Slide Up -->
            <DoubleAnimation
                Storyboard.TargetName="KartTransform"
                Storyboard.TargetProperty="Y"
                From="20" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- İkon pulse animasyonu -->
            <DoubleAnimation
                Storyboard.TargetName="IkonScaleTransform"
                Storyboard.TargetProperty="ScaleX"
                From="0.5" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="IkonScaleTransform"
                Storyboard.TargetProperty="ScaleY"
                From="0.5" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Yarı saydam arka plan overlay -->
    <Grid>
        <Border x:Name="AnaKart" Opacity="0" Margin="14">
            <Border.RenderTransform>
                <TranslateTransform x:Name="KartTransform" Y="20"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <!-- Ana Kart -->
            <Border CornerRadius="16" ClipToBounds="True">
                <Grid>
                    <!-- Arka plan -->
                    <Border Background="#1C1C30" CornerRadius="16"
                            BorderBrush="#3F3F5F" BorderThickness="1"/>

                    <!-- Sol renk aksanı (tip bazlı renk) -->
                    <Border x:Name="SolAksan" HorizontalAlignment="Left" Width="4"
                            CornerRadius="16,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="AksanRenk1" Color="#7C3AED" Offset="0"/>
                                <GradientStop x:Name="AksanRenk2" Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="4,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ═══════════════ BAŞLIK ÇUBUĞU ═══════════════ -->
                        <Border Grid.Row="0" Background="#14142A" CornerRadius="0,16,0,0"
                                Padding="20,14" MouseLeftButtonDown="BaslikSurukle">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- İkon Dairesi -->
                                    <Border x:Name="IkonDaire" Width="34" Height="34"
                                            CornerRadius="17" Margin="0,0,12,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="IkonScaleTransform" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop x:Name="IkonGradyan1" Color="#7C3AED" Offset="0"/>
                                                <GradientStop x:Name="IkonGradyan2" Color="#A78BFA" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock x:Name="txtIkon" Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="txtBaslik" Text="Bildirim"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Kapatma butonu -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Cursor="Hand" Click="KapatTiklandi"
                                        ToolTip="Kapat">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="kapatBd" Width="30" Height="30"
                                                    CornerRadius="8" Background="Transparent">
                                                <TextBlock Text="✕" FontSize="13"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="kapatBd" Property="Background" Value="#2A2A42"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ═══════════════ MESAJ İÇERİĞİ ═══════════════ -->
                        <Border Grid.Row="1" Padding="28,22,28,16">
                            <TextBlock x:Name="txtMesaj" Text="Mesaj"
                                       Foreground="#CBD5E1" FontSize="13.5" LineHeight="23"
                                       TextWrapping="Wrap" MaxWidth="400"/>
                        </Border>

                        <!-- ═══════════════ ALT AYIRICI + BUTONLAR ═══════════════ -->
                        <Border Grid.Row="2" Padding="20,0,20,20">
                            <Grid>
                                <!-- İnce ayırıcı çizgi -->
                                <Border Height="1" VerticalAlignment="Top" Margin="4,0,4,0"
                                        Opacity="0.3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#3F3F5F" Offset="0.2"/>
                                            <GradientStop Color="#3F3F5F" Offset="0.8"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <StackPanel x:Name="pnlButonlar" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,16,0,0">

                                    <!-- Üçüncü Buton (3 butonlu mod: İptal) -->
                                    <Button x:Name="btnUcuncu" Content="İptal" Visibility="Collapsed"
                                            Foreground="#94A3B8" Cursor="Hand" FontSize="13"
                                            FontWeight="SemiBold" Padding="18,10"
                                            Margin="0,0,8,0" Click="UcuncuTiklandi">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#252540"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#2A2A48"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- İptal / Hayır Butonu (opsiyonel) -->
                                    <Button x:Name="btnIptal" Content="İptal" Visibility="Collapsed"
                                            Foreground="#CBD5E1" Cursor="Hand" FontSize="13"
                                            FontWeight="SemiBold" Padding="20,10"
                                            Margin="0,0,8,0" Click="IptalTiklandi">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#252540" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderBrush="#3F3F5F" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#303055"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#5555AA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#3A3A5E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Ana Buton (Tamam / Evet) — Gradient arka plan -->
                                    <Button x:Name="btnTamam" Content="Tamam"
                                            Foreground="White" Cursor="Hand" FontSize="13"
                                            FontWeight="Bold" Padding="24,10"
                                            Click="TamamTiklandi">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop x:Name="ButonGradyan1" Color="#7C3AED" Offset="0"/>
                                                            <GradientStop x:Name="ButonGradyan2" Color="#6D28D9" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#6D28D9" Offset="0"/>
                                                                    <GradientStop Color="#5B21B6" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
