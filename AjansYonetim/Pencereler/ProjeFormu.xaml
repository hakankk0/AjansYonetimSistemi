<Window x:Class="AjansYonetim.Pencereler.ProjeFormu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proje Bilgileri"
        Width="540" Height="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" ClipToBounds="True" BorderBrush="#3F3F5F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid Background="{StaticResource ArkaPlanFirca}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Başlık Çubuğu -->
            <Border Grid.Row="0" Padding="24,16" MouseLeftButtonDown="Pencere_Surukle">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#14142A" Offset="0"/>
                        <GradientStop Color="#1A1A32" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtFormBaslik" Text="Yeni Proje Ekle" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="IptalTiklandi">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="32" Height="32" CornerRadius="8" Background="Transparent">
                                    <TextBlock Text="✕" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2A2A42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form İçeriği -->
            <Border Grid.Row="1" Margin="20,10,20,20" Background="{StaticResource KartFirca}" CornerRadius="12" Padding="24,20">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <!-- Şablondan Oluştur -->
                        <TextBlock FontSize="13" Style="{StaticResource FormEtiketStil}"><Run Text="&#xE762;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Şablondan Oluştur"/></TextBlock>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbSablon" Grid.Column="0" Style="{StaticResource ModernComboBoxStil}"
                                      SelectionChanged="SablonSecildi"/>
                            <Button Grid.Column="1" Content="＋" ToolTip="Yeni Şablon" Style="{StaticResource VurguButonStil}"
                                    Width="32" Height="32" FontSize="16" Margin="6,0,0,0" Padding="0"
                                    Click="YeniSablonTiklandi"/>
                            <Button Grid.Column="2" ToolTip="Şablon Düzenle" Style="{StaticResource IkincilButonStil}"
                                    Width="32" Height="32" FontSize="14" Margin="4,0,0,0" Padding="0"
                                    Click="SablonDuzenleTiklandi" FontFamily="Segoe MDL2 Assets" Content="&#xE70F;"/>
                            <Button Grid.Column="3" ToolTip="Şablon Sil" Style="{StaticResource TehlikeButonStil}"
                                    Width="32" Height="32" FontSize="14" Margin="4,0,0,0" Padding="0"
                                    Click="SablonSilTiklandi" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;"/>
                        </Grid>

                        <!-- Müşteri Seçimi -->
                        <TextBlock Text="Müşteri *" Style="{StaticResource FormEtiketStil}"/>
                        <ComboBox x:Name="cmbMusteri" Style="{StaticResource ModernComboBoxStil}"
                                  DisplayMemberPath="AdSoyad" Margin="0,0,0,14"/>

                        <!-- Proje Adı -->
                        <TextBlock Text="Proje Adı *" Style="{StaticResource FormEtiketStil}"/>
                        <TextBox x:Name="txtProjeAdi" Style="{StaticResource ModernTextBoxStil}" Margin="0,0,0,14"/>

                        <!-- Tarih Seçimleri -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Başlangıç Tarihi *" Style="{StaticResource FormEtiketStil}"/>
                                <DatePicker x:Name="dpBaslangic"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teslim Tarihi *" Style="{StaticResource FormEtiketStil}"/>
                                <DatePicker x:Name="dpTeslim"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fiyat ve Para Birimi -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="txtFiyatEtiketi" Text="Fiyat (₺) *" Style="{StaticResource FormEtiketStil}"/>
                                <TextBox x:Name="txtFiyat" Style="{StaticResource ModernTextBoxStil}"
                                         PreviewTextInput="FiyatSadeceRakam"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Para Birimi" Style="{StaticResource FormEtiketStil}"/>
                                <ComboBox x:Name="cmbParaBirimi" Style="{StaticResource ModernComboBoxStil}"
                                          SelectionChanged="ParaBirimiDegisti"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtKurBilgisi" Text="" FontSize="11"
                                   Foreground="{StaticResource VurguAcikFirca}" Margin="0,0,0,14"/>

                        <!-- Durum ve Kategori -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Durum *" Style="{StaticResource FormEtiketStil}"/>
                                <ComboBox x:Name="cmbDurum" Style="{StaticResource ModernComboBoxStil}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kategori" Style="{StaticResource FormEtiketStil}"/>
                                <ComboBox x:Name="cmbKategori" Style="{StaticResource ModernComboBoxStil}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Butonlar -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="İptal" Style="{StaticResource IkincilButonStil}"
                                    Padding="24,12" Margin="0,0,10,0" Click="IptalTiklandi"/>
                            <Button x:Name="btnKaydet" Grid.Column="2" Style="{StaticResource VurguButonStil}"
                                    Padding="24,12" FontWeight="Bold" Click="KaydetTiklandi">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Proje Kaydet" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
