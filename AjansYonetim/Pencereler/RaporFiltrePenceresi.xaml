<Window x:Class="AjansYonetim.Pencereler.RaporFiltrePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapor Filtresi"
        Width="440" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" ClipToBounds="True" BorderBrush="#3F3F5F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid Background="{StaticResource ArkaPlanFirca}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Çubuğu -->
            <Border Grid.Row="0" Padding="24,16" MouseLeftButtonDown="Pencere_Surukle">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#14142A" Offset="0"/>
                        <GradientStop Color="#1A1A32" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#60A5FA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Rapor Filtresi" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource MetinFirca}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="IptalTiklandi">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="32" Height="32" CornerRadius="8" Background="Transparent">
                                    <TextBlock Text="✕" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2A2A42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form İçeriği -->
            <StackPanel Grid.Row="1" Margin="24,16,24,0">
                <!-- Tarih Aralığı -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Başlangıç" Style="{StaticResource FormEtiketStil}"/>
                        <DatePicker x:Name="dpFiltreBaslangic"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource MetinSonikFirca}"
                               VerticalAlignment="Bottom" Margin="12,0,12,8" FontSize="16"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bitiş" Style="{StaticResource FormEtiketStil}"/>
                        <DatePicker x:Name="dpFiltreBitis"/>
                    </StackPanel>
                </Grid>

                <!-- Durum Filtresi -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Durum" Style="{StaticResource FormEtiketStil}"/>
                    <ComboBox x:Name="cmbFiltreDurum" Style="{StaticResource ModernComboBoxStil}"/>
                </StackPanel>

                <!-- Müşteri Filtresi -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Müşteri" Style="{StaticResource FormEtiketStil}"/>
                    <ComboBox x:Name="cmbFiltreMusteri" Style="{StaticResource ModernComboBoxStil}"/>
                </StackPanel>
            </StackPanel>

            <!-- Butonlar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                <Button Content="İptal" Style="{StaticResource IkincilButonStil}" Click="IptalTiklandi"
                        Margin="0,0,10,0" Padding="20,10"/>
                <Button Style="{StaticResource VurguButonStil}" Click="OlusturTiklandi" Padding="20,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Rapor Oluştur" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
